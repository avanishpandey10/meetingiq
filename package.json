{
  "name": "meetingiq",
  "version": "1.0.0",
  "description": "AI Meeting Intelligence & Action Tracker",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "setup": "npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}